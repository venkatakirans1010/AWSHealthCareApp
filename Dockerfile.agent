# Healthcare claims specialist-agent image.
ARG TARGETPLATFORM=linux/amd64
FROM --platform=$TARGETPLATFORM python:3.12-slim

ARG AGENT_RUNTIME

RUN case "$AGENT_RUNTIME" in \
      document-analysis|policy-validation|medical-coding|fraud-detection|claims-decision) ;; \
      *) echo "Unsupported AGENT_RUNTIME: $AGENT_RUNTIME" >&2; exit 1 ;; \
    esac

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TESSERACT_CMD=/usr/bin/tesseract \
    AGENT_RUNTIME=${AGENT_RUNTIME}

LABEL org.opencontainers.image.title="healthcare-claims-${AGENT_RUNTIME}" \
      com.healthcare-claims.agent-runtime="${AGENT_RUNTIME}"

WORKDIR /app

# The shared FastAPI module imports the OCR stack at startup, so each specialist
# image currently includes Tesseract even when its selected agent does not use it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY app ./app

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=3)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
