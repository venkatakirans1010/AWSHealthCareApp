AWS_REGION=ap-south-1
DATABASE_HOST=your-rds-instance.region.rds.amazonaws.com
DATABASE_NAME=healthcare-claims
AWS_PROFILE=healthcare-claims
S3_BUCKET_NAME=
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-local-development-password@localhost:5432/healthcare_claims
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGE=eng
OCR_RENDER_DPI=250
OCR_AUTO_VALIDATION_CONFIDENCE=95
OCR_VERIFICATION_CONFIDENCE=80
NORMALIZATION_REQUIRED_FIELDS=patient_id,provider_id,diagnosis_code,amount
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_POLICY_MODEL_ID=
BEDROCK_POLICY_RETRIEVAL_RESULTS=10
